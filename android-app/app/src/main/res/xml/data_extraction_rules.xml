<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Room database from cloud restore to prevent stale tenant data after reinstall -->
        <exclude domain="database" path="flowexa_db" />
        <exclude domain="database" path="flowexa_db-wal" />
        <exclude domain="database" path="flowexa_db-shm" />
        <exclude domain="sharedpref" path="flowexa_calls.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="flowexa_db" />
        <exclude domain="database" path="flowexa_db-wal" />
        <exclude domain="database" path="flowexa_db-shm" />
        <exclude domain="sharedpref" path="flowexa_calls.xml" />
    </device-transfer>
</data-extraction-rules>
